# Database
DATABASE_URL="postgresql://user:password@localhost:5432/agency_db?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key-here-change-in-production"

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Email (SendGrid or Resend)
EMAIL_FROM="noreply@youragency.com"
SENDGRID_API_KEY="your-sendgrid-api-key"
# OR
RESEND_API_KEY="your-resend-api-key"

# Analytics (optional)
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Site Configuration
NEXT_PUBLIC_SITE_URL="https://youragency.com"
NEXT_PUBLIC_SITE_NAME="Premium Agency"

# Feature Flags
ENABLE_REGISTRATION="false"
MAINTENANCE_MODE="false"
